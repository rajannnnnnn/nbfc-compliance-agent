# Copy to .env and fill in. app/config.py is the only module that reads these.
CC_ENV=local
CC_LOG_LEVEL=INFO

CC_DATABASE_URL=postgresql+asyncpg://cc_app:dev@localhost:5432/clausecheck
CC_REDIS_URL=redis://localhost:6379/0

# Embedding: see docs/DECISIONS.md ADR-004 for why 1536, not the LLD's literal 3072.
CC_EMBEDDING_MODEL=text-embedding-3-large
CC_EMBEDDING_DIMENSION=1536
CC_EMBEDDING_API_KEY=

CC_SERVING_MODE=hosted_baseline

# Real model ids required — see docs/DECISIONS.md ADR-011. LiteLLM routing strings,
# e.g. "openai/gpt-4o", "anthropic/claude-sonnet-4-5", "openai/gpt-4o-mini".
CC_EXTRACT_MODEL=openai/gpt-4o-mini
CC_VERDICT_MODEL=openai/gpt-4o
CC_CLASSIFY_MODEL=openai/gpt-4o-mini
CC_LLM_API_KEY=

CC_FAIL_BOOT_ON_PINNING_MISMATCH=true
